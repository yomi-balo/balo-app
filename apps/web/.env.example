# App
# BAL-436 — APP_URL is the PREFERRED setting and is read SERVER-SIDE ONLY. It is the same
# variable apps/api uses for every emailed link (apps/api/.env.example), so setting it here
# keeps a link copied from the in-call People panel and a link received by email pointing at
# the same origin. Both fall back to https://balo.expert when unset.
APP_URL=
# Read in the browser (build-time inlined). Still used by client-side surfaces; the join-link
# builder consults it only as a development fallback when APP_URL is unset.
NEXT_PUBLIC_APP_URL=

# Supabase
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WorkOS
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=

# Stripe
STRIPE_PUBLISHABLE_KEY=
# BAL-377 — the client Payment Element needs the publishable key inlined at build time
# (must carry the NEXT_PUBLIC_ prefix). pk_test_… in dev/staging, pk_live_… in prod.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Axiom
AXIOM_TOKEN=
AXIOM_DATASET=

# R2 (Cloudflare)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Ably (conversation realtime) — server-only. Optional: when unset, realtime
# degrades gracefully (messages still send; live updates arrive on next load).
ABLY_API_KEY=

# ── Mux signed playback (BAL-440) ─────────────────────────────────
# ⚠ ONLY TWO OF THE FIVE `MUX_*` VARS BELONG HERE. `apps/web` mints signed playback/thumbnail
# URLs for the recap recording player — it never creates a Mux asset and never receives a Mux
# webhook, so `MUX_TOKEN_ID`, `MUX_TOKEN_SECRET` and `MUX_WEBHOOK_SECRET` (apps/api's, Railway
# only) do NOT belong on Vercel. Do not add them here.
# Signed-playback key pair (Mux dashboard → Settings → Signing Keys) — the SAME pair already
# provisioned on Railway for `apps/api`. MUX_SIGNING_KEY_PRIVATE is the base64 PEM Mux hands
# out; store it verbatim, never re-encoded.
# ⚠ ABSENT → the poster mint fails soft (caught, logged, `posterUrl: null`, the designed
# `bg-muted` fallback renders) and the on-demand playback mint fails with a toasted error. The
# recap page itself still renders — nothing 500s.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
