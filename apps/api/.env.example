# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/balo

# ── Redis / BullMQ ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (WorkOS) ────────────────────────────────────────────────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# ── Email (Brevo + React Email) ──────────────────────────────────
BREVO_API_KEY=              # Brevo transactional email API key
BREVO_SENDER_EMAIL=notifications@balo.expert  # From address for all outbound email
BREVO_SMS_SENDER=Balo             # SMS sender name (max 11 alphanumeric chars)

# ── Analytics (PostHog) ─────────────────────────────────────────
POSTHOG_API_KEY=                # PostHog project API key (server-side; omit to disable)
POSTHOG_HOST=https://app.posthog.com

# ── Expert Search (BAL-246) ──────────────────────────────────────
# Availability gate for GET /experts/search. 'on' hides experts without a future
# availability slot; anything else (unset/'off') shows all searchable, approved
# experts. Leave unset/off in dev + test; set 'on' in Railway prod before the
# BAL-80 DNS cutover.
EXPERT_SEARCH_AVAILABILITY_GATE=off

# ── Display FX (ExchangeRate-API — BAL-380) ──────────────────────
# Presentation-only AUD→GBP/EUR/USD quotes for the daily fx-display-rate sweep.
# NEVER enters balance/settlement math (ADR-1040 invariant #8). Absent key → the sweep
# warns and skips (last-good rows retained; never crashes the cron).
EXCHANGERATE_API_KEY=            # ExchangeRate-API v6 key (server-side; omit to disable the FX sweep)
EXCHANGERATE_API_URL=https://v6.exchangerate-api.com/v6  # Optional base override (tests/staging)

# ── Payments (Stripe) — client charges only (ADR-1041) ───────────
# Single-var topology (ADR-1026 / BAL-382): the VALUE differs per env — test-mode below
# prod, live in prod — set in Railway/Vercel. No _PROD/_TEST branching in code.
STRIPE_SECRET_KEY=            # sk_test_… in dev/staging, sk_live_… in prod
STRIPE_PUBLISHABLE_KEY=       # pk_test_… / pk_live_… (frontend / consumer lane — BAL-377)
STRIPE_WEBHOOK_SECRET=        # whsec_… — per endpoint, per env (each endpoint has its own)

# ── Transcript pipeline (BAL-387 / ADR-1013) ─────────────────────
# LLM cleanup / summary / action-item extraction via the Vercel AI SDK (@ai-sdk/anthropic).
# ABSENT key → the pipeline uses a Noop client (warns once; passes raw text through, empty
# summary / 0 action items) so dev + CI complete end-to-end without a key — it NEVER crashes.
# Set in Railway prod to produce real LLM artifacts.
ANTHROPIC_API_KEY=              # Anthropic API key (server-side; omit → Noop LLM)
# Optional per-stage model overrides (default: claude-sonnet-5 for all stages).
TRANSCRIPT_CLEANUP_MODEL=       # override the cleanup model (default claude-sonnet-5)
TRANSCRIPT_SUMMARY_MODEL=       # override the summary + extraction model (default claude-sonnet-5)

# ── Video (Daily.co — BAL-129 / ADR-1044) ───────────────────────
# Server-side Daily REST key. Rooms are created `privacy: 'private'` — a public room's raw
# daily.co URL would bypass the app-side waiting-to-join queue entirely (D8). ABSENT key →
# room provisioning throws DailyConfigError; the booking still COMMITS and the route returns
# 201 with `provisioned: false` (the venue is stamped on a later provisioning call).
DAILY_API_KEY=                  # Daily.co API key (server-side)
# BAL-134 — the HMAC secret Daily returns when a webhook is created (POST /v1/webhooks).
# ⚠ REGISTERING THE WEBHOOK IS AN OPS STEP, ONCE PER ENVIRONMENT, not something code does.
# ⚠ ABSENT → POST /webhooks/daily answers 503 and processes NOTHING. That is deliberate: an
# unverified body must never reach a presence write. Presence then depends entirely on the
# per-minute lifecycle sweep's reconciliation, i.e. up to 60s of latency on every join/leave.
DAILY_WEBHOOK_SECRET=

# ── Mux (BAL-473 / ADR-1013 + 2026-07-14 amendment) ──────────────
# Mux API access token. Created in the Mux dashboard (Settings → Access Tokens).
# ⚠ ABSENT → getMuxClient() throws MuxConfigError, so EVERY `recording-ingest` job fails and
# every meeting_recordings row stalls at `source_ready`. The Daily source is retained, so the
# rows are re-drivable once the keys are set — nothing is lost, but nothing plays either.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# The signing secret Mux shows when a webhook endpoint is created (Settings → Webhooks).
# ⚠ REGISTERING THE WEBHOOK IS AN OPS STEP, ONCE PER ENVIRONMENT, not something code does.
# ⚠ ABSENT → POST /webhooks/mux answers 503 to EVERY delivery. Assets still transcode at Mux,
# but no row ever reaches `ready`, so no recording is ever playable and the Daily source is
# never cleaned up.
MUX_WEBHOOK_SECRET=
# Signed-playback key pair (Settings → Signing Keys). BAL-140 captured the API token ONLY —
# these are new. MUX_SIGNING_KEY_PRIVATE is the base64 PEM Mux hands out; store it verbatim.
# ⚠ ABSENT → signedPlaybackUrl()/signedThumbnailUrl() throw MuxConfigError. Ingest is
# unaffected; only playback URL minting (BAL-440's consumer) breaks.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# ── Balo ops ─────────────────────────────────────────────────────
# ⚠ LOAD-BEARING, AND SILENT WHEN UNSET. `recipient: 'admin'` rules resolve to this literal
# address; when it is missing the dispatcher log.warns and SKIPS THE SEND. That includes
# BAL-134's expert-absent salvage alert, which exists because Balo has committed to contacting
# an expert who has not turned up — so an unset value means nobody is told. `index.ts` emits one
# boot-time log.warn for exactly this reason.
OPS_NOTIFICATION_EMAIL=

# ── Meeting lifecycle timers (BAL-134 / ADR-1049) ────────────────
# ⚠ ALL FIVE ARE OPTIONAL. Absent or malformed → the shipped default, with one log.warn naming
# the variable. Values are WHOLE OR FRACTIONAL MINUTES and must be positive.
# ⚠ THEY ARE CHECKED FOR COHERENCE AS A SET: each alert must fire strictly BEFORE the
# termination it exists to prevent. An incoherent set discards EVERY override (log.error), so a
# typo cannot silently disarm an alert.
# MEETING_EXPERT_ABSENT_ALERT_MINUTES=5   # default 5  — ops alert, anchored on scheduled_start
# MEETING_MISSED_CALL_MINUTES=10          # default 10 — missed-call termination, same anchor
# MEETING_CLIENT_ABSENT_NUDGE_MINUTES=5   # default 5  — client nudge, anchored on the
#                                         #              EXPERT-PRESENT clock start
# MEETING_NO_SHOW_FLOOR_MINUTES=15        # default 15 — no-show settles, same anchor
# MEETING_IDLE_END_MINUTES=5              # default 5  — empty-room window for idle end and
#                                         #              abandoned wait

# ── Calendar (Apiroc — BAL-467 / ADR-1021) ───────────────────────
# Unified calendar API key. In `turbo.json` globalEnv but was missing here (fix brief round
# 2, item 15). ABSENT key → getApirocClient() throws ApirocConfigError on first use; the
# boundary is INERT in this ticket (constructed and tested, no live caller yet).
APIROC_API_KEY=
# Apiroc application id — required by getOAuthUrl (BAL-396 §1/§16).
APIROC_APP_ID=
# ⚠ MUST be allowlisted in the Apiroc dashboard (Application Details → Authorized Redirect
# URIs, BAL-394). Plain http://localhost IS accepted there, so no tunnel is needed for
# connect-flow work.
APIROC_REDIRECT_URI=https://api.balo.expert/auth/apiroc/callback

# ── Calendar webhooks (BAL-468) ──────────────────────────────────
# AES-256-GCM key for `calendar_subscriptions.endpoint_secret` at rest. A SEPARATE trust
# boundary from PAYOUT_ENCRYPTION_KEY — never reuse that value. 32+ random bytes, base64.
# ⚠ ABSENT → subscription reconciliation SKIPS (no vendor call, no row) and the webhook
# answers 503. That is deliberate: this whole path is INERT until both vars below are set.
# ⚠ ROTATION IS DESTRUCTIVE — see the runbook in the BAL-468 plan §17.
CALENDAR_ENCRYPTION_KEY=
# HTTPS origin the vendor POSTs change webhooks to, e.g. https://api.balo.expert
# ⚠ MUST be https (vendor requirement) — plain http://localhost is accepted for the OAuth
# redirectUrl but NOT for a webhookUrl, so local webhook work needs a tunnel.
# ⚠ ABSENT → reconciliation skips. This is the on-switch for the whole feature.
APIROC_WEBHOOK_BASE_URL=

# ── App ──────────────────────────────────────────────────────────
APP_URL=https://balo.expert  # Base URL used in email links (override per environment)
NODE_ENV=development
