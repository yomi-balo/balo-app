# BAL-393 spike — copy to `.env` and fill in. `.env` is git-ignored; never commit it,
# never paste these values into Linear, never log them (the harness redacts them).

# Sandbox x-api-key — Apiroc dashboard → API Keys. SECRET.
APIROC_API_KEY=

# App ID — Apiroc dashboard → API Keys. Not secret, still required for OAuth URLs.
APIROC_APP_ID=

# Must exactly match an entry in dashboard → Application Details → Authorized Redirect URIs.
APIROC_REDIRECT_URI=http://localhost:8787/callback

# Base URL. Override only if the sandbox is on a different host.
APIROC_BASE_URL=https://api.onecalunified.com

# --- Filled in during Phase 1, after you complete the OAuth consent in the browser ---
GOOGLE_END_USER_ACCOUNT_ID=
MICROSOFT_END_USER_ACCOUNT_ID=

# --- Phase 2 only: public HTTPS receiver base (cloudflared prints one, or use Railway) ---
WEBHOOK_PUBLIC_URL=
